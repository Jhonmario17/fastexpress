{
  "name": "fastexpress-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "coverage": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/cotizador.js", "src/app.js"],
    "coverageReporters": ["text", "html"],
    "coverageThreshold": { "global": { "lines": 85, "branches": 85 } }
  },
  "dependencies": { "cors": "^2.8.5", "express": "^4.19.2" },
  "devDependencies": { "jest": "^29.7.0", "supertest": "^7.0.0" }
}
